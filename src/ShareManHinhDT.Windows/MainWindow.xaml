<Window x:Class="ShareManHinhDT.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ShareManHinhDT — Màn hình Android" Width="1100" Height="760" MinWidth="760" MinHeight="540" Background="#101827" Foreground="#EEF3FA">
  <Grid x:Name="RootLayout" Margin="20" Background="#101827">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel x:Name="HeaderPanel" Margin="0,0,0,16">
      <StackPanel><TextBlock Text="ShareManHinhDT" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Chia sẻ màn hình Android qua mạng nội bộ" Foreground="#A8B6CC" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="StartButton" Content="Bắt đầu nhận" Click="StartClick" Padding="18,10" Margin="8,0"/>
        <Button x:Name="StopButton" Content="Dừng" Click="StopClick" Padding="18,10" IsEnabled="False"/>
        <Button x:Name="FullScreenButton" Content="Toàn màn hình (F11)" Click="FullScreenClick" Padding="12,10" Margin="8,0,0,0"/>
      </StackPanel>
    </DockPanel>
    <Border x:Name="PairingPanel" Grid.Row="1" Background="#1D2A3E" CornerRadius="10" Padding="14" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,16,0">
        <TextBlock x:Name="AddressText" Text="Bấm Bắt đầu nhận để ghép đôi." FontSize="15" TextWrapping="Wrap"/>
        <ComboBox x:Name="AddressSelector" DisplayMemberPath="Label" SelectionChanged="AddressSelectionChanged" Margin="0,8,0,0" Padding="6" Foreground="#101827" Background="#EEF3FA"/>
        <TextBlock x:Name="CodeText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock Text="Quét QR bằng ứng dụng Android để kết nối. Nếu nhập thủ công, đối chiếu vân tay chứng chỉ ở lần đầu." TextWrapping="Wrap" Foreground="#A8B6CC" Margin="0,8,0,4"/>
        <TextBox x:Name="FingerprintText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#B9CBE4" BorderThickness="0" FontFamily="Consolas"/>
      </StackPanel>
      <StackPanel Grid.Column="1" x:Name="QrPanel" Visibility="Collapsed" VerticalAlignment="Center">
        <Border Background="White" Padding="8"><Image x:Name="PairingQrImage" Width="260" Height="260" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
        <TextBlock Text="Quét QR để kết nối với PC" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="ScreenPanel" Grid.Row="2" Background="#060B12" CornerRadius="10" ClipToBounds="True">
      <Grid><Image x:Name="ScreenImage" Stretch="Uniform"/><TextBlock x:Name="PlaceholderText" Text="Màn hình điện thoại sẽ xuất hiện tại đây" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#71829C"/></Grid>
    </Border>
    <DockPanel x:Name="StatusPanel" Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="Sẵn sàng" TextWrapping="Wrap"/><TextBlock x:Name="MetricsText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#A8B6CC"/></DockPanel>
  </Grid>
</Window>
